      "pattern": "N-COUNT",
      "definition": "A <b>flurry</b> of activity, or <i>a brief spell</i> of snow.",
      "examples": [
        {
          "text": "There was a flurry of snow overnight."
        },
        {
          "text": "A flurry of <i>excitement</i> spread through the crowd.",
          "translation": "A sudden wave of excitement spread through the crowd."
        }
      ]
    },
