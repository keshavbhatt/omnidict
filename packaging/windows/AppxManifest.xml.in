<?xml version="1.0" encoding="utf-8"?>
<!-- The MSIX manifest (ADR-022); scripts/ci/package-windows.ps1 writes @VERSION@. The identity
     is the one Partner Center assigned to Omnidict (Store ID 9P5NP69TJVS6). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="12809keshavnrj.Omnidict"
            Publisher="CN=4537E417-5797-495B-9457-854BBCC482B6"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Omnidict</DisplayName>
    <PublisherDisplayName>keshavnrj</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Omnidict" Executable="bin\omnidict.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Omnidict"
                          Description="Offline dictionary for any language"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Omnidict" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start at login, in the tray (services::Autostart, mocks/windows.html note 4): off
             until the user turns it on in Settings. -->
        <uap5:Extension Category="windows.startupTask" Executable="bin\omnidict.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="OmnidictStartup" Enabled="false" DisplayName="Omnidict" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
